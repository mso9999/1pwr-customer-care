# Zambia API process. Production values belong in /opt/1pdb-zm/.env (mode 600).
COUNTRY_CODE=ZM
CC_API_PORT=8103
DATABASE_URL=postgresql://cc_api:PASSWORD@localhost:5432/onepower_zm
DATABASE_URL_ZM=postgresql://cc_api:PASSWORD@localhost:5432/onepower_zm

# Fail closed until the approved site roster, tariff, metering platform and
# payment samples have passed canary validation.
PAYMENT_AUTOMATION_ENABLED=0
SMS_INGEST_PUSH_SPARKMETER=0
METER_CREDIT_ENABLED=0
RELAY_AUTO_TRIGGER_ENABLED=0
SMS_PAYMENT_RECEIPT_ENABLED=0

# Shared CC authentication/AWS IoT values are required but intentionally not
# repeated here. Copy only the approved common keys from the host secret store.
