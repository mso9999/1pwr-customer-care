# .gitignore
__pycache__/
*.pyc
*.pyo
node_modules/
.env
*.accdb
*.mdb
auth_info_baileys/
*.log
.DS_Store
.dropbox_cache/
firebase-service-account.json
firebase-service-account.json*

# Laptop context snapshots and retired local files. Not application source.
CONTEXT_SYNC*.md
_local_archive/

# Local SSH keys (e.g. CC EC2). Copy EOver.pem into .secrets/ yourself — never commit keys.
.secrets/**
!.secrets/README.md
EOver.pem

# Pandoc-generated Word exports (open locally; do not commit)
docs/ops/*.docx

# LaTeX build artifacts (e.g. 1meter-1pdb-white-paper.tex)
docs/ops/*.aux
docs/ops/*.out
# Local AI assistant state
.claude/

# Firmware drops at repo root (do not commit)
/1meter-fw-*.zip

# Avoid committing finance / export spreadsheets
/docs/*.xlsx
